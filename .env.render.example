# Local runtime only. Copy with npm run env:setup. Node 24.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
TRUST_PROXY=1
LOG_LEVEL=info
# Restricted dsu_api role; never use the administrator connection here.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_CA_PATH=/etc/secrets/prod-ca-2021.crt
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy /v1 only. Current /api/v1 always requires a verified user JWT.
SERVICE_TOKEN=
CORS_ORIGINS=https://YOUR_WEB.onrender.com
# Local memory is for one development process. Production requires Redis.
RATE_LIMIT_MODE=redis
REDIS_URL=
RATE_LIMIT_USER_MAX=240

# Keep stable: rotating invalidates assigned-test class codes.
ASSESSMENT_CODE_SECRET=
RATE_LIMIT_IP_MAX=6000
OPENROUTER_API_KEY=
STUDENT_AI_MODEL=
OPENROUTER_PROVIDER=baseten/fp8,deepinfra/fp8
STUDENT_AI_CONCURRENCY=2
