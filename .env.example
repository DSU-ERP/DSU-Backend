# DSU Backend (consolidated API + backend). Server-side only.
# Copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=4000
# Behind exactly one trusted proxy (Render). Not for direct exposure.
TRUST_PROXY=0

# --- Required: database -----------------------------------------------------
# Restricted runtime role. Must be the dsu_api role: the service refuses to
# start with a superuser, a BYPASSRLS role, or any other username.
# URL-encode passwords. Verified TLS is mandatory for remote databases.
DATABASE_URL=
DATABASE_SSL=true
# Path to the Supabase CA certificate. On Render use a secret file such as
# /etc/secrets/prod-ca-2021.crt. Never set rejectUnauthorized=false.
DATABASE_CA_PATH=

# --- Required: authentication ----------------------------------------------
# User bearer tokens are verified against Supabase Auth on every request.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Required: service boundary --------------------------------------------
# At least 32 characters. Guards the legacy /v1 prefix, which is retained for
# cutover compatibility. The public /api/v1 prefix does not use it; that path
# is protected by the Supabase user token plus the erp.memberships role check.
SERVICE_TOKEN=

# --- Required: browser origins ---------------------------------------------
# Exact origins, comma separated. No wildcards.
CORS_ORIGINS=

# --- Operator only, never set in Render -------------------------------------
# Migration/provisioning owner URL. Keep on an authorised operator machine.
DATABASE_ADMIN_URL=

# --- Retired by the consolidation -------------------------------------------
# DSU_API_URL            the gateway no longer forwards to a separate service
# ENABLE_PUBLIC_GATEWAY  /api/v1 is now always registered
