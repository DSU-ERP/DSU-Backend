{
  "name": "dsu-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:provision": "node --env-file-if-exists=.env scripts/provision.js",
    "csv:import": "node --env-file-if-exists=.env scripts/import-csv.js",
    "access:grant": "node --env-file-if-exists=.env scripts/grant-access.js",
    "verify:analytics": "node --env-file-if-exists=.env scripts/verify-analytics.js",
    "verify:database": "node --env-file-if-exists=.env scripts/verify-database.js",
    "verify:placement-imports": "node --env-file-if-exists=.env scripts/verify-placement-imports.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "csv-parse": "^7.0.3",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  }
}
