{
  "name": "dsu-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:testing": "node --env-file=.env.competency-testing scripts/start-competency-testing.js",
    "competency:install:testing": "node --env-file=.env.testing --env-file=.env.testing.operator scripts/competency-testing.js --apply",
    "competency:verify:testing": "node --env-file=.env.testing --env-file=.env.testing.operator scripts/verify-competency-testing.js",
    "test:competency": "node --no-wasm-tier-up --test --test-concurrency=1 test/competency-engine.test.js test/competency-database.test.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "mcp:web-search": "node --env-file-if-exists=.env mcp/web-search-server.js",
    "test": "node --no-wasm-tier-up --test --test-concurrency=1",
    "db:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/db-check.js",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/migrate.js",
    "db:migrate:testing": "node --env-file-if-exists=.env.testing --env-file-if-exists=.env.testing.operator scripts/migrate-testing.js",
    "db:check:testing": "node --env-file-if-exists=.env.testing --env-file-if-exists=.env.testing.operator scripts/check-testing-target.js",
    "db:seed:testing": "node --env-file-if-exists=.env.testing --env-file-if-exists=.env.testing.operator scripts/import-testing-students.mjs",
    "verify:testing-import": "node --env-file-if-exists=.env.testing --env-file-if-exists=.env.testing.operator scripts/verify-testing-import.js",
    "db:status": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/db-status.js",
    "db:provision": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/provision.js",
    "csv:import": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/import-csv.js",
    "access:grant": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/grant-access.js",
    "verify:analytics": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/verify-analytics.js",
    "verify:database": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/verify-database.js",
    "env:setup": "node scripts/setup-env.js",
    "env:check": "node --env-file-if-exists=.env scripts/check-env.js",
    "access:lock-rpc": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/lock-rpc-access.js",
    "test:capacity": "node --no-wasm-tier-up scripts/verify-capacity.js",
    "access:officer": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/grant-placement-officer.js",
    "placement:import": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/import-placement-records.js",
    "verify:placement-imports": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/verify-placement-imports.js",
    "verify:friday-rename": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/verify-friday-rename.js",
    "access:admin": "node --env-file-if-exists=.env --env-file-if-exists=.env.operator scripts/grant-admin.js",
    "storage:buckets": "node --env-file-if-exists=.env scripts/create-storage-buckets.js",
    "dev:provision-student": "node scripts/provision-dev-student.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "csv-parse": "^7.0.3",
    "fastify": "^5.6.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "mammoth": "^1.13.0",
    "octokit": "5.0.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "xlsx": "0.18.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  }
}
