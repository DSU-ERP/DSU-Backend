# Local runtime only. Copy with npm run env:setup. Node 24.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
TRUST_PROXY=0
LOG_LEVEL=info
# Restricted dsu_api role; never use the administrator connection here.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_CA_PATH=
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy /v1 only. Current /api/v1 always requires a verified user JWT.
SERVICE_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local memory is for one development process. Production requires Redis.
RATE_LIMIT_MODE=memory
REDIS_URL=
RATE_LIMIT_USER_MAX=240

# Keep stable: rotating invalidates assigned-test class codes.
ASSESSMENT_CODE_SECRET=
RATE_LIMIT_IP_MAX=6000
OPENROUTER_API_KEY=
STUDENT_AI_MODEL=
OPENROUTER_PROVIDER=baseten/fp8,deepinfra/fp8
STUDENT_AI_CONCURRENCY=2
# Web research for Observation Haki (official APIs only; empty = disabled).
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
WEB_SEARCH_PROVIDERS=brave,google
WEB_SEARCH_TRANSPORT=direct

# Student skills intelligence (docs/STUDENT-INTELLIGENCE.md section 8).
# AES-256-GCM keys for stored platform tokens: comma-separated kid:base64,
# each exactly 32 bytes. Generate one with:
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Keep old kids in the list after rotating; set the key id to the newest kid.
INTEGRATION_ENCRYPTION_KEYS=
INTEGRATION_ENCRYPTION_KEY_ID=
# GitHub App (user authorization with PKCE). Only public data is read.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Web callback route; HTTPS required in production.
GITHUB_OAUTH_REDIRECT_URL=http://localhost:3000/student/connections/github/callback
# Background platform sync (on|off), parallel jobs (1-4), refresh interval (1-168 hours).
SYNC_WORKER=on
SYNC_WORKER_CONCURRENCY=2
SYNC_INTERVAL_HOURS=24
# development|staging|production. Only scripts/provision-dev-student.js reads it,
# together with explicitly exported DEV_SUPABASE_URL, DEV_DATABASE_ADMIN_URL,
# DEV_SUPABASE_SERVICE_ROLE_KEY, DEV_STUDENT_PASSWORD, DSU_PROTECTED_PROJECT_REFS and
# DEV_ALLOW_LOCAL_DB=1 (only to allow a localhost development database)
# (never put those in this file).
DSU_ENVIRONMENT=
